# Copy to .env.local (or .env) and fill in. Both are gitignored.

# Public site origin, used for canonical/OG URLs and every customer-facing
# property link. Leave unset to use the production domain; set it only to
# override (a Vercel preview, a custom domain).
# NEXT_PUBLIC_SITE_URL=https://asqdevs-empire.vercel.app

# --- AI phone receptionist (real voice) — OPTIONAL ---
# Gemini Live API key from Google AI Studio (https://aistudio.google.com/apikey).
# The Live API has a free tier, so this demo can run at no cost within its limits.
#
# Without this key the phone demo automatically falls back to the text call,
# which still runs the full conversation and produces a structured lead.
#
# This key is used ONLY on the server. The browser receives a short-lived
# HMAC relay ticket, never this key — server.mjs proxies the Live WebSocket.
GEMINI_API_KEY=

# Optional overrides (defaults shown)
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Aoede

# --- Voice relay (only for hosts that cannot run server.mjs, e.g. Vercel) ---
# server.mjs embeds the WebSocket relay, so local dev needs none of these.
# Vercel cannot hold a WebSocket, so deploy relay.mjs (npm run relay) to a
# WebSocket-capable host (Railway / Render / Fly) and point the app at it here.
# Set these on BOTH the app and the relay service as noted.
#   App (Vercel):
# VOICE_RELAY_URL=https://your-relay-host.example.com
# VOICE_RELAY_TOKEN=choose-a-long-random-string
#   Relay service:
# GEMINI_API_KEY=...
# VOICE_RELAY_TOKEN=choose-a-long-random-string
# VOICE_ALLOWED_ORIGIN=https://asqdevs-empire.vercel.app
# RELAY_PORT=8080

# --- WhatsApp assistant (text) — uses the same GEMINI_API_KEY ---
# The WhatsApp reply is a Gemini text turn, so it reads this key too. It walks a
# short list of flash models and answers from the first one that responds —
# free-tier quota is per model, so a single exhausted model used to send every
# turn to the scripted fallback. The list is ordered by speed and availability
# rather than version: an overloaded newest model at the front made every reply
# wait through a failed request first. Set this only to force a specific model
# to the front of that list.
# GEMINI_TEXT_MODEL=gemini-3-flash-preview
