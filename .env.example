# Copy to .env.local (or .env) and fill in. Both are gitignored.

# Public site origin, used for canonical/OG URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI phone receptionist (real voice) — OPTIONAL ---
# Gemini Live API key from Google AI Studio (https://aistudio.google.com/apikey).
# The Live API has a free tier, so this demo can run at no cost within its limits.
#
# Without this key the phone demo automatically falls back to the text call,
# which still runs the full conversation and produces a structured lead.
#
# This key is used ONLY on the server. The browser receives a short-lived
# HMAC relay ticket, never this key — server.mjs proxies the Live WebSocket.
GEMINI_API_KEY=

# Optional overrides (defaults shown)
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Aoede

# --- WhatsApp assistant (text) — uses the same GEMINI_API_KEY ---
# The WhatsApp reply is a Gemini text turn, so it reads this key too. It is
# pinned to one model by default and walks a short list of flash models when one
# is out of quota, because free-tier limits are per model: a single exhausted
# model used to send every WhatsApp turn to the scripted fallback. Set this only
# to force a specific model to the front of that list.
# GEMINI_TEXT_MODEL=gemini-3.8-flash
